[Unit]
Description=MultiChat API server
After=network.target

[Service]
Type=simple
ExecStart=%h/bin/multichat-server
WorkingDirectory=%h/repos/multichat
Environment=PORT=8402

# MULTICHAT_DB pins the database ABSOLUTELY. It points at the same file the service
# has always used -- the one inside the checkout -- but it pins it, and that is the
# whole point. cmd/server/main.go used to open the bare relative path "multichat.db",
# so the database was wherever systemd happened to chdir. SQLite does not fail on a
# missing file, it creates one: get the working directory wrong and multichat comes
# up with every route answering out of a brand-new EMPTY database while the real
# contacts and tags sit untouched on disk. Absolute path, no ambiguity.
Environment=MULTICHAT_DB=%h/repos/multichat/multichat.db

Environment=SYNAPSE_URL=http://localhost:8008
Environment=TELEGRAM_DB=%h/multichat/telegram-data/mautrix-telegram.db
Environment=META_DB=%h/multichat/meta-data/mautrix-meta.db
Environment=DISCORD_DB=%h/multichat/discord-data/mautrix-discord.db
Environment=WHATSAPP_DB=%h/multichat/whatsapp-data/mautrix-whatsapp.db
Environment=GMESSAGES_DB=%h/multichat/gmessages-data/mautrix-gmessages.db
Environment=SIGNAL_DB=%h/multichat/signal-data/mautrix-signal.db
Environment=PEOPLE_STORE_URL=http://127.0.0.1:8321
# POST /api/short-names/assign reads and writes chat short names here.
Environment=SHORT_NAME_STORE_URL=http://127.0.0.1:8325

# Custom Discord emoji. POST /emoji/discord/refresh lists each bridged server's
# emoji with a Discord bot token it resolves from auth-store by credential id:
# the Event-Manager bot, which discord-signup-store also uses and which is a
# member of every bridged server. AUTH_STORE_TOKEN is a secret and lives in the
# EnvironmentFile below.
Environment=AUTH_STORE_URL=http://127.0.0.1:8303
Environment=DISCORD_EMOJI_BOT_CREDENTIAL_ID=cred_22fe3b634452cd7482719afd

# Inbound messaging. With NATS_URL set the server long-polls Synapse /sync and
# publishes every message a person sends us as messaging.inbound (JetStream);
# scheduler jobs with an event_trigger on that subject start agent sessions.
# LLM_BRIDGE_URL is where the short-name pass asks a model to name chats.
Environment=NATS_URL=nats://localhost:4222
Environment=LLM_BRIDGE_URL=http://localhost:8160

# The secrets -- MULTICHAT_TOKEN, MATRIX_TOKEN, OPENAI_API_KEY -- live in this
# host-local file, mode 600, and NOT in this template. They used to sit inline as
# Environment= lines in the live unit, which was survivable only because that unit
# was untracked; committing them here would publish a live Matrix access token and a
# live OpenAI key to a public GitHub repo. deploy.sh creates this file (migrating the
# values off the live unit the first time) and REFUSES to deploy if it is missing.
#
# 🔴 MULTICHAT_TOKEN IS NOT OPTIONAL AND ITS AUTH FAILS OPEN. api/router.go:49 reads
# `if authToken != "" { ...check the bearer token... }` -- so an EMPTY or absent
# MULTICHAT_TOKEN does not lock everyone out, it turns authentication OFF ENTIRELY.
# This API is proxied to the internet at chat.kayushkin.com, and it serves contacts,
# conversations and message history, plus AI routes that spend the OpenAI key. Losing
# this one variable silently publishes all of it. That is why deploy.sh will not
# install a unit it cannot prove the token behind, and asserts a 401 after every
# deploy rather than trusting that the file was read.
EnvironmentFile=%h/.config/multichat/multichat.env

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
